rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Our Little Universe: Avinash & Athulya private space
    // End-to-end encrypted with passwords Avi123 / Sree123.
    // Unconditional couple access so no Firebase Anonymous Auth setup is required.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
